{
  "info": {
    "_postman_id": "bb97a276-173b-42ea-a51e-a64cc1d13e07",
    "name": "NotesApp",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "53857239",
    "_collection_link": "https://go.postman.co/collection/53857239-bb97a276-173b-42ea-a51e-a64cc1d13e07?source=collection_link"
  },
  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();\r",
              "if (jsonData.token) {\r",
              "    pm.environment.set(\"token\", jsonData.token);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"ahmed@test.com\",\r\n  \"password\": \"123456\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/users/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "New Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();\r",
              "if (jsonData._id) {\r",
              "    pm.environment.set(\"noteId\", jsonData._id);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"title\": \"My First Note\",\r\n  \"content\": \"This is content for my first note\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/notes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "notes"
          ]
        }
      },
      "response": []
    }
  ]
}